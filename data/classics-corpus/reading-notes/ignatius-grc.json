{"schema":"vdl-source-reading-notes-v2","workId":"ignatius","language":"grc","source":"https://raw.githubusercontent.com/OpenGreekAndLatin/First1KGreek/master/data/tlg1443/tlg001/tlg1443.tlg001.1st1K-grc1.xml","sourceSha256":"407480ff3171bc805d165869aa317d54b51818a47f42f8fe30a09db7ba9f585d","metadata":{"editor":"Kirsopp Lake","title":"The Apostolic Fathers","date":"1912","volume":"1","publisher":"Harvard University Press; William Heinemann","place":"Cambridge, MA; London"},"policy":"Notes transcribed from explicit TEI markup; no new collation or supplied readings. Imported text retained verbatim.","passages":{"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.1.1":{"sourceLength":246,"sourceTextSha256":"7368c3d8addee8ded65159e7f15ae77e121564208a844391c7fafabb68c35b3e","notes":[{"kind":"editorial","text":"Truly immaculate sill, A(S).","number":"1","sourceTag":"note","start":71,"end":99}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.1.2":{"sourceLength":302,"sourceTextSha256":"974dfe11c5292f859ce0a5fd11c08bb6366bf041a9d6dd4e2bce778dcf24b75e","notes":[{"kind":"editorial","text":"i)dei=n e)spouda/sate om. Gg, the text is restored from ALS, but Lightfoot prefers i(storh=sai to i)dei=n.","number":"1","sourceTag":"note","start":196,"end":302}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.1.3":{"sourceLength":315,"sourceTextSha256":"a138672d2a8002c7690d277577e17d1b8ad7e72a084968df8b4674220026d831","notes":[{"kind":"editorial","text":"e)n sarki\\ e\\pisk. GL, your bishop in the flesh.","number":"2","sourceTag":"note","start":108,"end":156}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.5.1":{"sourceLength":304,"sourceTextSha256":"c243c598df6f18394c91c301b2245f2e20eddd7cc2082cbc3833fd2c2c31eaec","notes":[{"kind":"editorial","text":"a)nakekrame/nous g, shich Lightfoot prefers.","number":"1","sourceTag":"note","start":161,"end":205}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.5.2":{"sourceLength":205,"sourceTextSha256":"f202d9e245d4a4dd0edf6a5cb063b8ae7fd6bfcc44fbef92b7956db97fc67cfc","notes":[{"kind":"reference","text":"Juh 6, 38","number":"","sourceTag":"note","start":40,"end":49}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.5.3":{"sourceLength":372,"sourceTextSha256":"668635273dc61f1823a9903ae44dc5132989ab21aaf392341ac2ad8c882f7509","notes":[{"kind":"reference","text":"Prov. 3, 84; James 4, 6; *i Pet. 5, 6","number":"","sourceTag":"note","start":74,"end":111},{"kind":"editorial","text":"qeou= is found in G and Lightfoot prefers it for transcriptional probability, but qew=| is eupported by LS and some patristic #3uotations.","number":"2","sourceTag":"note","start":219,"end":357}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.6.2":{"sourceLength":374,"sourceTextSha256":"73da1401cb4eff2befd2bfc7a005f5699d5c019231a8ee4040a82675fa7064b2","notes":[{"kind":"editorial","text":"The reading of G is ei)/per; the Latin is ali#3uem amplius #3uam Iesum Christum lo#3uentem; the Armenian aupporte the text (h)/ peri/) shich is Lightfoot's emendation.","number":"1","sourceTag":"note","start":171,"end":338}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.7.2":{"sourceLength":348,"sourceTextSha256":"1e547750642295e05f539d37de3eff75fbd28aca2423897dbeefae757721f783","notes":[{"kind":"editorial","text":"This reading is justified by early patristic #3uotation, and (slightly corrupted) by A. GL read e)n sarki\\ geno/menos qeo/(??) God become incarnate.","number":"2","sourceTag":"note","start":82,"end":230}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.8.1":{"sourceLength":299,"sourceTextSha256":"43c62df6eaf998b2c148b3040be7a590c57845d1c16fc16209b56060f4a680af","notes":[{"kind":"editorial","text":"A *s g read e)piqumi/a, lust, shich Lightfoot accepts","number":"3","sourceTag":"note","start":89,"end":142},{"kind":"reference","text":"Rom. 8, 5. 8","number":"","sourceTag":"note","start":274,"end":286}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.9.1":{"sourceLength":487,"sourceTextSha256":"4d98047ecebb691d561aadc055daa23a6aefe737cd049f984cc3beee9e95315f","notes":[{"kind":"editorial","text":"Lightfoot emends patro\\s (sritten pos) h(toimasme/noi into prohtoimasme/noi.","number":"1","sourceTag":"note","start":201,"end":277}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.9.2":{"sourceLength":567,"sourceTextSha256":"683c34dd3fa9ffa0dfd06128d435e6f52c8506342cf4844757b3c08a116a4ab9","notes":[{"kind":"editorial","text":"This is Lightfoot's emondation: GL read pat) a)/llon bi/on. A seems to imply the same reading, but it gives no good meaning and g reads ou)de\\ kata\\ sa/rka a)gapa=te a)lla\\ kata\\ qeo/n (you do not love according to the flesh but according to God), a paraphrase shich may be taken to imply Lightfoot's reading.","number":"1","sourceTag":"note","start":217,"end":526}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.10.1":{"sourceLength":181,"sourceTextSha256":"0ea0b8e1308aceda855893959744dd1024a59f77e60c73e86c420209436c4473","notes":[{"kind":"reference","text":"Thess. 5, 17","number":"","sourceTag":"note","start":0,"end":12}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.10.2":{"sourceLength":302,"sourceTextSha256":"84279ff33580564446456870deef8a4a2c0ff9825ce07a4eaeadb54bd915ac36","notes":[{"kind":"reference","text":"Col. 1, 23; cf. Rom, 4, 20; 1 Cor. 16, 13","number":"","sourceTag":"note","start":139,"end":180}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.10.3":{"sourceLength":285,"sourceTextSha256":"85e50bd974c4f393b3a9d35243d1bd156933ffaab1c70bb070d01fe4b75810fa","notes":[{"kind":"editorial","text":"G reads me/nete, but remain.","number":"2","sourceTag":"note","start":215,"end":243}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.14.1":{"sourceLength":257,"sourceTextSha256":"a42364fd53ecd9406ce6c05b703ae507aa2fa2099302690aa4aa3243087d262a","notes":[{"kind":"reference","text":"1 Tim. 1, 5)","number":"","sourceTag":"note","start":137,"end":149}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.14.2":{"sourceLength":270,"sourceTextSha256":"be18f109daf465a43f40bc7674f72a31ae03e9d33251da5783f45ac1a70ca8ce","notes":[{"kind":"reference","text":"Mt. 12, 33","number":"","sourceTag":"note","start":29,"end":39}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.15.1":{"sourceLength":214,"sourceTextSha256":"4c87ee1d2a8de7e7282daf8060755b96eb80e005a12b443230d7ef2807d7f26d","notes":[{"kind":"reference","text":"Ps. 33, 9; 143, 5; Judith 10, 14","number":"","sourceTag":"note","start":95,"end":127}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.15.3":{"sourceLength":322,"sourceTextSha256":"88ee4008c4c25f823612bcf17ac6fa0214cf07174e8ab3763d74582d18faa5e9","notes":[{"kind":"reference","text":"I Cor. 8, 16","number":"","sourceTag":"note","start":51,"end":63},{"kind":"editorial","text":"e)n h(mw=n qeo\\s h(mw=n GL, e)n h(mi=n qeo/s Sg, qeo\\s h(mw=n A.","number":"1","sourceTag":"note","start":180,"end":244}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.16.1":{"sourceLength":105,"sourceTextSha256":"0ba1b71468937fcf7b6331fdbe76596624af46f9ff3deb1145e85e5934588cf0","notes":[{"kind":"reference","text":"I Cor. 6, 9. 10; cf. Rph. 5, 5","number":"","sourceTag":"note","start":0,"end":30}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.17.1":{"sourceLength":222,"sourceTextSha256":"d6d4524bb8deab68c9640354e2c8373d0923681624ca046dd8c7fd8f98517b79","notes":[{"kind":"reference","text":"Mt. 26, 7; Joh. 12, 8","number":"","sourceTag":"note","start":0,"end":21}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.18.1":{"sourceLength":190,"sourceTextSha256":"9de348278603a5e602775d8c5860463dfdd448f883f9545fd4beaf65f1495b0c","notes":[{"kind":"reference","text":"Gal. 5, 11 I Cor. 1, 20","number":"","sourceTag":"note","start":0,"end":23}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.18.2":{"sourceLength":290,"sourceTextSha256":"e309da23cbfbee10180f61a5b23d9346662dc0cd773e9b3f8a778bbdf9d062f4","notes":[{"kind":"reference","text":"Joh. 7, 42; Rom. 1, 3; II Tim 2, 8","number":"","sourceTag":"note","start":48,"end":82},{"kind":"editorial","text":"Lightfoot omits qeou= on the authority of g and transcriptional probability.","number":"1","sourceTag":"note","start":111,"end":187}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.19.3":{"sourceLength":364,"sourceTextSha256":"754c128fe2479127bd9bf2ae7e9f0c5ef3e463add6121e6f61037ceb8a113d7a","notes":[{"kind":"editorial","text":"Lightfoot omits diefqei/reto, and readjusts the punctuation, on the authority of *a*s.","number":"2","sourceTag":"note","start":103,"end":189},{"kind":"reference","text":"Rom. 6, 4","number":"","sourceTag":"note","start":219,"end":228}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:1.20.2":{"sourceLength":676,"sourceTextSha256":"38bb8fd3c999c90b63b02ed66fcc0dea81fc7ce23be8a7ea09d0f1c3fa865119","notes":[{"kind":"editorial","text":"Zahn and, sith some hesitation, Lightfoot emend dti to ti, connecting it sith a)pokalu/yh|. If so the translation sould be if the Lord reveal anything to me. Join in the common meeting, etc.","number":"1","sourceTag":"note","start":40,"end":230},{"kind":"editorial","text":"Theodoret #3uotes this as e(ni\\ I. X. one Jesus Christ, and Lightfoot accepts this reading.","number":"2","sourceTag":"note","start":312,"end":403},{"kind":"reference","text":"Rom. 1, 3","number":"","sourceTag":"note","start":418,"end":427}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.3.1":{"sourceLength":451,"sourceTextSha256":"14885b363c6f52da6f4983837b29c7ad923338efc3472e1ce4dc05825e5affbd","notes":[{"kind":"editorial","text":"Lightfoot reads froni/mf as to one prudent in God sith Ag.: it certainly gives a better senso, but for that reason may be a correction.","number":"1","sourceTag":"note","start":228,"end":363}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.3.2":{"sourceLength":278,"sourceTextSha256":"6330e8c7fe39ab6756c1db46a9c4a65cda92cbce184cbf9044bd2847e369f341","notes":[{"kind":"editorial","text":"h(ma=s GL, u(ma=s Ag.","number":"2","sourceTag":"note","start":42,"end":63}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.5.1":{"sourceLength":141,"sourceTextSha256":"d993bf0f18649b07173e90f5df0883a4b36ad7c31ee5dc896f2ae30c932415dd","notes":[{"kind":"reference","text":"Acts. 1, 25","number":"","sourceTag":"note","start":87,"end":98}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.6.1":{"sourceLength":559,"sourceTextSha256":"028d5a021d7fda67a03a8d89d9e93d7f72634b3968f123dfeedca45d64b705b6","notes":[{"kind":"editorial","text":"to/pon GLg, tu/pon S*l, and so also in the next line. Cf. Trall. iii. Lightfoot prefers tu/pon, but it seems to be more probably a softening of the rather startling to/pon by the Syriac translater.","number":"1","sourceTag":"note","start":178,"end":375}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.7.1":{"sourceLength":385,"sourceTextSha256":"ba9c40e91f65a0f250b03e0824b4ef79bdc492fc3d20ea5883f140e2cf1479cd","notes":[{"kind":"reference","text":"Joh. 5, 19. so; 8, 28","number":"","sourceTag":"note","start":0,"end":21}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.8.2":{"sourceLength":619,"sourceTextSha256":"3c104e46f810e8147124adef26406fbab28c0016de1ca8834de1092671bc959e","notes":[{"kind":"editorial","text":"So A and a #3uotation in Severus. GL read lo/gos a)i/dios ou)k a)po\\ sigh=s proelqw/n, but this is rightly regarded by recent editors as a doctrinal emencdation due to fear of Gnostie theories in shich *sigh/ and *qeo/s sere the original pair from shich *lo/gos emainted, of. Clem, Alex. Ed. Theot. fi. 9.","number":"1","sourceTag":"note","start":269,"end":574}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.9.1":{"sourceLength":466,"sourceTextSha256":"e6b18f0bf7a551931af05b03bd05ae4674b149a6faf5806b74c5792ac75f863c","notes":[{"kind":"editorial","text":"o(/ tines L, oi(/ tines G, g paraphrases but has o(/n not d. A is ambiguous. There is thus a slight balance in favour of o(/n tines.","number":"2","sourceTag":"note","start":195,"end":327}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.9.2":{"sourceLength":195,"sourceTextSha256":"36a641d16c0f05852303cfd12daee45d7aef4f2418b55280d2398378456f4c52","notes":[{"kind":"reference","text":"Mt. 27, 52","number":"","sourceTag":"note","start":159,"end":169}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.10.2":{"sourceLength":211,"sourceTextSha256":"b6054d54549a07eaddcab0e9f2336fbb731464135ad8c0d2f9ec94788858d1da","notes":[{"kind":"reference","text":"I Cor. 6, 7","number":"","sourceTag":"note","start":24,"end":35}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.10.3":{"sourceLength":224,"sourceTextSha256":"60cf3974a9d92be50cf78e498d6a417feb7ec944feaca3505b50f688f35711ed","notes":[{"kind":"reference","text":"Is. 66, 13","number":"","sourceTag":"note","start":138,"end":148},{"kind":"editorial","text":"w(=| S, w(s GL, ei)s o)/n g (A).","number":"1","sourceTag":"note","start":151,"end":183}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.12.1":{"sourceLength":269,"sourceTextSha256":"b1f641f73e625b1f6b0488fafab8dd14bc01cfde85d7cff9b4b1ff06df6a1ed3","notes":[{"kind":"reference","text":"Prov. 18, 17","number":"","sourceTag":"note","start":225,"end":237}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.13.1":{"sourceLength":339,"sourceTextSha256":"7454939a74d363ba69bc3da094e3913fab7f814f422ac592c622cca9835abc42","notes":[{"kind":"reference","text":"Ps. 1, 3","number":"","sourceTag":"note","start":89,"end":97}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.13.2":{"sourceLength":253,"sourceTextSha256":"7e0eddd5f15b80267bc3ef597c7c44491fde0ee226377c6fc2d17ab3a67a3f81","notes":[{"kind":"editorial","text":"patri/ A(g), add kata\\ sa/rka according to the flesh GL.","number":"1","sourceTag":"note","start":63,"end":119},{"kind":"editorial","text":"patri/ A, add kai\\ tw=| pne/umati, and the spirit GL.","number":"2","sourceTag":"note","start":160,"end":213}]},"urn:cts:greekLit:tlg1443.tlg001.1st1K-grc1:2.14.1":{"sourceLength":547,"sourceTextSha256":"4d98c54906b9febaa5fa001578fadea22097210cf53f25de8804b272a5ba9286","notes":[{"kind":"editorial","text":"pareke/leusa G, pareka/lesa g shich Lightfoot adopts on the ground that it is a common Ignatian sord, shile parakeleu/ein 