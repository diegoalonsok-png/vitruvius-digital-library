":182}]},"3.9.9-18":{"sourceLength":591,"sourceTextSha256":"3341d845981036c4fa53ef0ff28b66e5fb5f13797d2799c1207e1b79c1618d86","notes":[{"kind":"editorial","text":"GU give this line in two places, here and after line 11. The reading is uncertain. Owen reads lita for tibi , taken from circumlita in Ψ .","number":"","sourceTag":"note","start":269,"end":407}]},"3.9.17-26":{"sourceLength":505,"sourceTextSha256":"2db24f09d46ba1ac957a728ec4b17089d3110f075816227d9a4056bf928fce43","notes":[{"kind":"editorial","text":"scelerare P Büch.: celebrare Ψ ( fortasse melius Housman).","number":"","sourceTag":"note","start":392,"end":450}]},"3.9.25-34":{"sourceLength":511,"sourceTextSha256":"154f9acecbdb5f0b3b72622a7e0ed90b1d5f19c2e758ae8649877f927d14ea83","notes":[{"kind":"editorial","text":"scelerare P Büch.: celebrare Ψ ( fortasse melius Housman).","number":"","sourceTag":"note","start":33,"end":91}]},"3.9.33-42":{"sourceLength":482,"sourceTextSha256":"13418847df652f5acfeb3be8ac4db7c37987c5044dc6fcaae74896823521636f","notes":[{"kind":"editorial","text":"numera Ψ : numeras P.","number":"","sourceTag":"note","start":398,"end":419}]},"3.9.41-50":{"sourceLength":480,"sourceTextSha256":"f6476060b65ac7c98a0320a2984c56c68840b02532d9fd3f9c4961fd92809f8d","notes":[{"kind":"editorial","text":"numera Ψ : numeras P.","number":"","sourceTag":"note","start":25,"end":46}]},"3.9.57-66":{"sourceLength":488,"sourceTextSha256":"d01ab0561037e926dbbb9bc3f1309c3b2e9f157732ccc67d3852c23fb21b7b02","notes":[{"kind":"editorial","text":"For ne hic (P Ψ ) Housman conjectured nunc .","number":"","sourceTag":"note","start":162,"end":206}]},"3.9.113-122":{"sourceLength":524,"sourceTextSha256":"6d89b5f2ce91c65b74505f2205e12b747fdb9d6aa8cc8d67d027305f500e711b","notes":[{"kind":"editorial","text":"tum est his . So Housman instead of the tunc est of PA.","number":"","sourceTag":"note","start":260,"end":315},{"kind":"editorial","text":"After 9.118 PA; after 9.123 Ψ .","number":"","sourceTag":"note","start":360,"end":