{"schema":"vdl-source-reading-notes-v2","workId":"juvenal-saturae","language":"la","source":"https://raw.githubusercontent.com/PerseusDL/canonical-latinLit/master/data/phi1276/phi001/phi1276.phi001.perseus-lat2.xml","sourceSha256":"7539945f88afb4c33b121c5a1b43e572d5a12a67b5ef68b297b6c8b43c287e3a","metadata":{"editor":"G. G. Ramsay","title":"Juvenal and Persius","date":"1918","volume":"","publisher":"William Heinemann; G. P. Putnam's Son","place":"London; New York"},"policy":"Notes transcribed from explicit TEI markup; no new collation or supplied readings. Imported text retained verbatim.","passages":{"1.1.17-26":{"sourceLength":471,"sourceTextSha256":"e871f6f3647d4e7f195f6f1c46ad58e9e774d04fe313aab6126c3111d807ba92","notes":[{"kind":"editorial","text":"line repeated at 10.226.","number":"","sourceTag":"note","start":404,"end":428}]},"1.1.25-34":{"sourceLength":465,"sourceTextSha256":"7ece670a0ac609d3b7e166a1e1818551d53270effa921abb5e5bdd801c799b3a","notes":[{"kind":"editorial","text":"line repeated at 10.226.","number":"","sourceTag":"note","start":47,"end":71}]},"1.1.33-42":{"sourceLength":495,"sourceTextSha256":"e703dc41ee3c80b363b667735086a97308e0a957a6441732b448a809f537b534","notes":[{"kind":"editorial","text":"palpat is omitted by P.","number":"","sourceTag":"note","start":132,"end":155},{"kind":"editorial","text":"noctibus Vind. Ψ : non tibi P.","number":"","sourceTag":"note","start":252,"end":282}]},"1.1.65-74":{"sourceLength":454,"sourceTextSha256":"4d79d798427639001d84ff5bfa5ab92be7a84f599b4f0f29cdb5eb4f6d9710a5","notes":[{"kind":"editorial","text":"falsi P: falso Ψ","number":"","sourceTag":"note","start":100,"end":116}]},"1.1.105-114":{"sourceLength":489,"sourceTextSha256":"8e987bd84c4d3a695bd554b6738533de18709684cbc80d81e1d9ba5f53506200","notes":[{"kind":"editorial","text":"habitas Ψ : habitat P Vind. OT Büch. Housman","number":"","sourceTag":"note","start":412,"end":456}]},"1.1.113-122":{"sourceLength":682,"sourceTextSha256":"c7a7eff77fb6c94b19d5f8aba92b9f90890912ff8fcae7580a9debe5583e7fb8","notes":[{"kind":"editorial","text":"habitas Ψ : habitat P Vind. OT Büch. Housman","number":"","sourceTag":"note","start":53,"end":97},{"kind":"editorial","text":"In place of the dull atque of P Ψ , Postgate, supported by the reading firma found in the MS. II, has made the brilliant conj. Fama , approved by L. Havet. See Class. Quart, iii. p. 67.","number":"","sourceTag":"note","start":152,"end":337}]},"1.1.121-130":{"sourceLength":511,"sourceTextSha256":"4518900206d8bbe420c643de2062360a49758471afb40c504d99ee2e5c618835","notes":[{"kind":"editorial","text":"quiescit Vind. Ψ : quiescaet P: quiescet Büch. Housman.","number":"","sourceTag":"note","start":273,"end":328}]},"1.1.137-146":{"sourceLength":521,"sourceTextSha256":"9bd0602e9006166299623feb019f9b7c25d8243a2c0c8980de7e1d43eb8f19b4","notes":[{"kind":"editorial","text":"P has crudus : crudum Ψ etc.","number":"","sourceTag":"note","start":289,"end":317},{"kind":"editorial","text":"So AL and Housman: Büch. follows the et of P.","number":"","sourceTag":"note","start":393,"end":438}]},"1.1.145-154":{"sourceLength":569,"sourceTextSha256":"82e25ae84d8e307d3ec9128cc49ab4c6a9c37748ac05db4120f88112a7f483a2","notes":[{"kind":"editorial","text":"So AL and Housman: Büch. follows the et of P.","number":"","sourceTag":"note","start":3,"end":48},{"kind":"editorial","text":"dicas Ψ : dices PO: Housman prefers dicas ; see Journal of Phil. No. 67, p. 43.","number":"","sourceTag":"note","start":295,"end":374}]},"1.1.153-162":{"sourceLength":806,"sourceTextSha256":"da1adf6cdbcac8e446265355e54bb6a5083fa3476e0c71db87ee01d8d033f6c4","notes":[{"kind":"editorial","text":"P has lucebit : so also GT","number":"","sourceTag":"note","start":121,"end":147},{"kind":"editorial","text":"Büch. (1893 edn.) reads pectore , as do PAO and Owen: gutture is read by Vind.GLTU. So Housman; see Journal of Phil. No. 67, p. 45.","number":"","sourceTag":"note","start":192,"end":323},{"kind":"editorial","text":"So pO: deducit P Housman: Büch. (1910) conj. ducetis . Owen conj. dent lucis , reading ut for et . Housman supposes a line dropped out after 1.156, containing the word cadaver which becomes the subject to deducit .","number":"","sourceTag":"note","start":362,"end":576}]},"1.1.161-170":{"sourceLength":497,"sourceTextSha256":"89afbdcddf25629cc56844ad30fb2c0cc4d137790c71967d6533f247792245ca","notes":[{"kind":"editorial","text":"ira Housman following AGLO: Büch. reads irae from P.","number":"","sourceTag":"note","start":318,"end":370}]},"1.2.33-42":{"sourceLength":500,"sourceTextSha256":"a018874ec79372bb9391527a2856209191db18f6942133dc7599545937917a2c","notes":[{"kind":"editorial","text":"Housman punctuates ubi nunc, lex Iulia, dormis?","number":"","sourceTag":"note","start":225,"end":272}]},"1.2.41-50":{"sourceLength":540,"sourceTextSha256":"8344c3ce0979f316a1476debd0d37878978d61789cd1099d4d6938aee41668d0","notes":[{"kind":"editorial","text":"ac iura Ψ (see 1. 72): acturae P.","number":"","sourceTag":"note","start":124,"end":157},{"kind":"editorial","text":"nam Housman from O: hi Vinci. Ψ and Büch.: qui Büch. (1910).","number":"","sourceTag":"note","start":241,"end":301}]},"1.2.73-82":{"sourceLength":447,"sourceTextSha256":"05eeddacba2f5e0942babb49557cf71835b51453836dacc3cd36dd1e5275aa43","notes":[{"kind":"editorial","text":"prurigine P.","number":"","sourceTag":"note","start":344,"end":356}]},"1.2.97-106":{"sourceLength":537,"sourceTextSha256":"53c20bf5934d6df470c9622c36f79d16feb136e2f6a37fcee428ea43428a8f8b","notes":[{"kind":"editorial","text":"The words Actoris Aurunci spolium are a quotation from Virg. Aen. 12.94.","number":"","sourceTag":"note","start":156,"end":228},{"kind":"editorial","text":"spolium Ψ O: solium Herwerd. Housman.","number":"","sourceTag":"note","start":482,"end":519}]},"1.2.105-114":{"sourceLength":562,"sourceTextSha256":"55294efc3cad8182dfa11acae7977f8d55574e499dfa5f4f8f47c15ba8cda5c1","notes":[{"kind":"editorial","text":"spolium Ψ O: solium Herwerd. Housman.","number":"","sourceTag":"note","start":65,"end":102},{"kind":"editorial","text":"faciem Clausen and Willis, so P1, AKLO; facie P2, GHTUZ","number":"","sourceTag":"note","start":142,"end":197},{"kind":"editorial","text":"turpis PVind. Ψ : turpes TParis.","number":"","sourceTag":"note","start":371,"end":403}]},"1.2.145-154":{"sourceLength":526,"sourceTextSha256":"c7552389a0149addf891e881e9fad1eb4b4938780a35951bf4e94eec8242764d","notes":[{"kind":"editorial","text":"et contum ΣVind. Ψ : et pontum PSTU. Housman reads Cocytum after Luitprandus, Antapodosis 5 B.","number":"","sourceTag":"note","start":217,"end":311}]},"1.2.153-162":{"sourceLength":499,"sourceTextSha256":"0771e8b44d24dc1b87c90cb368393b9168ff645df79365060a65b3bca10c8998","notes":[{"kind":"editorial","text":"illic Vind.GL: illuc ATU and appar. P.","number":"","sourceTag":"note","start":288,"end":326}]},"1.2.161-170":{"sourceLength":514,"sourceTextSha256":"6d365a3116de653778687e592c220beffc04709ce44cde0d54dfb6f83874fd1b","notes":[{"kind":"editorial","text":"induerit Willis, following Nisbet","number":"","sourceTag":"note","start":318,"end":351},{"kind":"editorial","text":"non umquam GLOT Housman: non numquam PUBüch.","number":"","sourceTag":"note","start":371,"end":415}]},"1.3.9-18":{"sourceLength":472,"sourceTextSha256":"8e11fd8e3ace5b82e47839ac8740576bd1f6b4b66f563870912661b7e37d636a","notes":[{"kind":"editorial","text":"praestantius p Ψ : presentius Vind.","number":"","sourceTag":"note","start":431,"end":466}]},"1.3.17-26":{"sourceLength":497,"sourceTextSha256":"8ccd7af8188b04c4b7fb9b3d93eda9affa7ff7d628d11216fe4ed0e608dd10da","notes":[{"kind":"editorial","text":"praestantius p Ψ : presentius Vind.","number":"","sourceTag":"note","start":80,"end":115}]},"1.3.33-42":{"sourceLength":517,"sourceTextSha256":"fe67367860632e686f03320d2a4c695836dffec871e9fe85eca47f3bad84821b","notes":[{"kind":"editorial","text":"quem Ψ : cum PAUBüch. and Housman","number":"","sourceTag":"note","start":179,"end":212},{"kind":"editorial","text":"Büch. punctuates et cur non? omnia cum sint.","number":"","sourceTag":"note","start":301,"end":345}]},"1.3.105-114":{"sourceLength":535,"sourceTextSha256":"218371837d34cc559fe80da35380e7f04daff219896dfe2150424ccba635eab0","notes":[{"kind":"editorial","text":"P defective here. Most MSS. have aut for est . Housman reads aut tibi .","number":"","sourceTag":"note","start":205,"end":276},{"kind":"editorial","text":"Pinzger rejects","number":"","sourceTag":"note","start":477,"end":492}]},"1.3.113-122":{"sourceLength":458,"sourceTextSha256":"9651ed1968937f83024bc20761fc8f13c3afb66dbcfb25bab16346d8e48a6f3e","notes":[{"kind":"editorial","text":"Pinzger rejects","number":"","sourceTag":"note","start":46,"end":61}]},"1.3.201-210":{"sourceLength":459,"sourceTextSha256":"6d90b3ae86f37cfa784270bcbca87633eaaf1f894bf4f1d66a08cf9903d20316","notes":[{"kind":"editorial","text":"est PRAO","number":"","sourceTag":"note","start":451,"end":459}]},"1.3.209-218":{"sourceLength":589,"sourceTextSha256":"036854538e75220bd59588c5bd87bbed11295cf627cf47d6b76d349ad6612907","notes":[{"kind":"editorial","text":"est PRAO","number":"","sourceTag":"note","start":96,"end":104},{"kind":"editorial","text":"praeclarum P: Housman conj. praedarum .","number":"","sourceTag":"note","start":402,"end":441},{"kind":"editorial","text":"hic conj. by Jahn and confirmed by O and Vind.: haec P Büch.: Housman conj. aera .","number":"","sourceTag":"note","start":472,"end":554}]},"1.3.217-226":{"sourceLength":573,"sourceTextSha256":"84f7925394f165697f373342db066be07ec63ab27b98a955be7f53d4035fd023","notes":[{"kind":"editorial","text":"praeclarum P: Housman conj. praedarum .","number":"","sourceTag":"note","start":23,"end":62},{"kind":"editorial","text":"hic conj. by Jahn and confirmed by O and Vind.: haec P Büch.: Housman conj. aera .","number":"","sourceTag":"note","start":93,"end":175}]},"1.3.225-234":{"sourceLength":509,"sourceTextSha256":"09194499e304e52106125a38433a58f8b556d1aef5b9ad7fc2120bef79e584fa","notes":[{"kind":"editorial","text":"Housman adopts the conj. quem (Hadr. Valesius): quae PALO.","number":"","sourceTag":"note","start":434,"end":492}]},"1.3.233-242":{"sourceLength":602,"sourceTextSha256":"9f44821229196654e0ed8c4af0ac97ebac711af209b76743c7bf3789a581a218","notes":[{"kind":"editorial","text":"Housman adopts the conj. quem (Hadr. Valesius): quae PALO.","number":"","sourceTag":"note","start":75,"end":133},{"kind":"editorial","text":"Büch. and Owen read inflexu , after PVind. Ψ : Housman in flexu . See Journal of Phil. No. 67, p. 40.","number":"","sourceTag":"note","start":253,"end":354}]},"1.3.313-322":{"sourceLength":503,"sourceTextSha256":"8e23b05bb9af48b6aa018ab6cd2dccece8e1a76e2aa12d9224c27a089de88521","notes":[{"kind":"editorial","text":"auditor PVind. Büch. (1910): adiutor Ψ Büch. (1893).","number":"","sourceTag":"note","start":415,"end":467}]},"1.4.1-10":{"sourceLength":637,"sourceTextSha256":"06030d6655ec138105ad169c4643ec194b3b7f89f860769fac1cc4a0c39fce1e","notes":[{"kind":"editorial","text":"Willis rejects 4.1-36, following Ribbeck","number":"","sourceTag":"note","start":50,"end":90},{"kind":"editorial","text":"aspernatur Ψ : aspernatus Vind. etc. and Housman: sper. natur PSA.","number":"","sourceTag":"note","start":212,"end":278},{"kind":"editorial","text":"minime PVind. Ψ : quin sit ς : Housman conj. qum sit .","number":"","sourceTag":"note","start":447,"end":501},{"kind":"editorial","text":"Clausen rejects, following Jahn","number":"","sourceTag":"note","start":520,"end":551}]},"1.4.17-26":{"sourceLength":474,"sourceTextSha256":"452c0b743a9c18c69fac287d19d79529395a3f14cc74da6059c89c6574bf5345","notes":[{"kind":"editorial","text":"P has squamae . So Büch.","number":"","sourceTag":"note","start":382,"end":406}]},"1.4.25-34":{"sourceLength":455,"sourceTextSha256":"9d6bf86cdf2b0b5c3799dd48b1e9b14c87634c19bad535ab00486c57c6c327af","notes":[{"kind":"editorial","text":"P has squamae . So Büch.","number":"","sourceTag":"note","start":19,"end":43}]},"1.4.65-74":{"sourceLength":469,"sourceTextSha256":"4ec751d168d0e80f901ddee8582410b01ed2cde55879b1b05112a7f33bd8c003","notes":[{"kind":"editorial","text":"saginam PS: saginis Ψ Vind.","number":"","sourceTag":"note","start":126,"end":153}]},"1.4.73-82":{"sourceLength":467,"sourceTextSha256":"dc1e02fc773b4bbf979496214cdfa469f0c0eba9818c4d4e01b4dd1e3d75e5e8","notes":[{"kind":"editorial","text":"quamquam Vind. Ψ : quamque P.","number":"","sourceTag":"note","start":311,"end":340}]},"1.4.121-130":{"sourceLength":477,"sourceTextSha256":"09aac613f51beffce9b4b554480c44162fd2f440e7714a3411438f31055c6a3b","notes":[{"kind":"editorial","text":"Housmam conj. per for in .","number":"","sourceTag":"note","start":323,"end":349}]},"1.5.33-42":{"sourceLength":443,"sourceTextSha256":"f74f4f5f8d37ab1b8feadf4d3f9a5d9dc3553264e9c450ec7f97b6cd4943fe80","notes":[{"kind":"editorial","text":"illic Ψ .","number":"","sourceTag":"note","start":417,"end":426}]},"1.5.41-50":{"sourceLength":438,"sourceTextSha256":"1b25d72712d274a908d89fce5f323b84425d22bf651a319950018323077b2327","notes":[{"kind":"editorial","text":"illic Ψ .","number":"","sourceTag":"note","start":70,"end":79}]},"1.5.73-82":{"sourceLength":484,"sourceTextSha256":"946fc065c95467a0d4762b5439d9cac5d98e1c19cad6ca0dace4d53dad3aba05","notes":[{"kind":"editorial","text":"distinguat P Vind.: distendat Ψ .","number":"","sourceTag":"note","start":343,"end":376}]},"1.5.89-98":{"sourceLength":540,"sourceTextSha256":"8999515380706bc21d8e456305573af9f8f680e2dc8d3f422f0ff844f676cbc4","notes":[{"kind":"editorial","text":"This line and 6.126 are the only two lines omitted by P (excepting, of course, vi. O 1-34).","number":"","sourceTag":"note","start":128,"end":219}]},"1.5.113-122":{"sourceLength":465,"sourceTextSha256":"17db95fd0438049071e4e53ddca5690e6a043bd0a4407c331fd6cdad109e255d","notes":[{"kind":"editorial","text":"spumat PSA: fumat Ψ .","number":"","sourceTag":"note","start":142,"end":163}]},"2.6.25-34":{"sourceLength":476,"sourceTextSha256":"5d2e50a7e1c26c9b8fdee640af9a9c2c340de01151700f34c16d5145dc50fee4","notes":[{"kind":"editorial","text":"exagitare P Ψ : exagitere O.","number":"","sourceTag":"note","start":214,"end":242}]},"2.6.41-50":{"sourceLength":463,"sourceTextSha256":"f47c2042fb1cd43568c6be4418ed5984920b1abbd0f9b20df490f81aa9ae5974","notes":[{"kind":"editorial","text":"Cereris P Ψ : Housman conj. teretis .","number":"","sourceTag":"note","start":400,"end":437}]},"2.6.49-58":{"sourceLength":476,"sourceTextSha256":"04c2ebd5e2bd8351b5aeba6ba8e6400f10eee0dd9083dc9013944d7b25d863e2","notes":[{"kind":"editorial","text":"Cereris P Ψ : Housman conj. teretis .","number":"","sourceTag":"note","start":63,"end":100}]},"2.6.113-122":{"sourceLength":482,"sourceTextSha256":"b91f54679b5c1a18bf11c53f0330d949386c6d139dffb373a2bbef0213ef79ee","notes":[{"kind":"editorial","text":"Clausen transposes 6.117 and 6.118, following Hermann.","number":"","sourceTag":"note","start":212,"end":266}]},"2.6.121-130":{"sourceLength":466,"sourceTextSha256":"704df1a7ad165d46f2595f8628d7a784e9ab9ab15e576eb13c1dd90dc8045a61","notes":[{"kind":"editorial","text":"omitted by PR Ψ .","number":"","sourceTag":"note","start":271,"end":288}]},"2.6.145-154":{"sourceLength":463,"sourceTextSha256":"53b31178e22b7e81917468a33674bf89cb6a59942292de606c45f96d415d34bb","notes":[{"kind":"editorial","text":"quo PA: cum Ψ","number":"","sourceTag":"note","start":384,"end":397}]},"2.6.153-162":{"sourceLength":521,"sourceTextSha256":"0d82be3cea0c65e9eea3c5ec48516b00b876cc0f45462bbed93cad510a266d12","notes":[{"kind":"editorial","text":"quo PA: cum Ψ","number":"","sourceTag":"note","start":25,"end":38},{"kind":"editorial","text":"dedit hunc S Ψ : dedit huc P: Housman conj. gestare .","number":"","sourceTag":"note","start":274,"end":327}]},"2.6.193-202":{"sourceLength":504,"sourceTextSha256":"2e1787620b950f19a00bd3799179512602e63ed97726a9c5e8cb1cbd8caa142e","notes":[{"kind":"editorial","text":"Housman conj. ferendis for the relictis of P Ψ .","number":"","sourceTag":"note","start":134,"end":182}]},"2.6.345-354":{"sourceLength":641,"sourceTextSha256":"bd90c6162a82c90c93be41ede5311396f0601abbd624bbe87211e58afafb0501","notes":[{"kind":"editorial","text":"P here has the false reading prohibe for cohibe .","number":"","sourceTag":"note","start":108,"end":157},{"kind":"editorial","text":"Lines 6.346-348 are repeated below, with an addition, as O 29-34. Clausen rejects these verses here; Willis accepts these and rejects O.1-34.","number":"","sourceTag":"note","start":233,"end":374}]},"2.6.361-371O":{"sourceLength":702,"sourceTextSha256":"78d8c8e5dfbe9fe405eeab56741ec070dd6bc1ff337728c8ee441acfa3913852","notes":[{"kind":"editorial","text":"Housman and Clausen accept the following thirty-four lines (MS O 1-34); Willis rejects them, following Buecheler. The verses were discovered in 1899 by Mr. E. O. Winstedt in Bodleian MS. O (formerly MS Canonicianus 41). Classical Review, May, 1899, pp. 201 foll.","number":"","sourceTag":"note","start":262,"end":524}]},"2.6.369O-379O":{"sourceLength":720,"sourceTextSha256":"dc4b581c99bb72efd7f89c64009ff43f73a9550b61f2c52310e2e192e578b594","notes":[{"kind":"editorial","text":"psellus so Housman and Owen: O reads psillus : Büch. Psyllus . Eupholio O: Housman reads euphono : Büch. conj. Euhoplio .","number":"","sourceTag":"note","start":227,"end":348},{"kind":"editorial","text":"O reads pulsatamque arma : Housman conj. pulsata hastamque : pulsata arcaque Owen: pulsantemque Postgate: Büch. conj. pulsaloremque tridentem and compares 6.40","number":"","sourceTag":"note","start":462,"end":621}]},"2.6.394O-368":{"sourceLength":519,"sourceTextSha256":"e3130ce0e0e565cd0f2d179e879a613f99313e6b69ecf09476dfc76cb70b3c50","notes":[{"kind":"editorial","text":"O here reads custodiat , but P Ψ have custodiet in the repeated passage, line 347.","number":"","sourceTag":"note","start":171,"end":253}]},"2.6.367-374b":{"sourceLength":563,"sourceTextSha256":"428087b953e4ce091befeceb13434647e5fe2f2468a4639add284afa23d7cbbb","notes":[{"kind":"editorial","text":"The MS. O alone gives two additional lines between 6.373 and 6.374. O reads magonum : Postgate mangonum . Clausen (1992) accepts.","number":"","sourceTag":"note","start":342,"end":471}]},"2.6.405-414":{"sourceLength":487,"sourceTextSha256":"ebcc673554fd944bfe47bda633ade9a2d2f2e0b60f60574e5c9aa228a3121e60","notes":[{"kind":"editorial","text":"arva Ψ : arma P.","number":"","sourceTag":"note","start":267,"end":283},{"kind":"editorial","text":"quod Ψ : quae P.","number":"","sourceTag":"note","start":429,"end":445}]},"2.6.413-422":{"sourceLength":508,"sourceTextSha256":"0cba5aa336e58599ea9cbe7c0dc0f6a1a6f84a92e11a2365bdc0ca7e399b8495","notes":[{"kind":"editorial","text":"quod Ψ : quae P.","number":"","sourceTag":"note","start":49,"end":65},{"kind":"editorial","text":"exorata Ψ : exortata P, Housman, Büch. (1910).","number":"","sourceTag":"note","start":116,"end":162}]},"2.6.453-462":{"sourceLength":638,"sourceTextSha256":"f7651022f13b421d3d3fca0b47747262068f54d7be2b3ef8ab9f425735cc1aaf","notes":[{"kind":"editorial","text":"Housman puts a full stop after viris , and interprets: aliasque res virorum cura indignas . Postgate suggests, after one of Ruperti's MSS., haec curanda viris ?","number":"","sourceTag":"note","start":98,"end":258},{"kind":"editorial","text":"Clausen and Willis reject line 6.460, following Paldamus.","number":"","sourceTag":"note","start":502,"end":559}]},"2.6.549-558":{"sourceLength":545,"sourceTextSha256":"a8dd6a1c00c37a0fa32e9a68e1a668163d9e42f7000b16516b35944e7ff2841a","notes":[{"kind":"editorial","text":"Lines 6.558-59 are omitted in PFG and not noted in the scholia. Clausen rejects them, as does Willis, following Hermann.","number":"","sourceTag":"note","start":425,"end":545}]},"2.6.557-566":{"sourceLength":556,"sourceTextSha256":"41836ee0156656fcb8ac7049fe9605afad1a495ad0476db60dfc01d5e5b1d075","notes":[{"kind":"editorial","text":"Lines 6.558-59 are omitted in PFG and not noted in the scholia. Clausen rejects them, as does Willis, following Hermann.","number":"","sourceTag":"note","start":83,"end":203}]},"2.6.565-574":{"sourceLength":508,"sourceTextSha256":"2dcdb4fd19d7ad118c26002ab2464736d61b4aa00a23c21d205d5cb78087d362","notes":[{"kind":"editorial","text":"haec ignorat GLOU: haec ignorant T: hae ignorant Büch (1893).","number":"","sourceTag":"note","start":201,"end":262}]},"2.6.581-590":{"sourceLength":619,"sourceTextSha256":"bfa3cc41a203948fead1bb42ef5cf32f416d9eefda8b29e429da67b0cd9169f9","notes":[{"kind":"editorial","text":"dabit PG: dabunt FTU.","number":"","sourceTag":"note","start":202,"end":223},{"kind":"editorial","text":"indus Brit. 15 B xvii: inde P ςΨ : indi U: Owen and Büch. (1893) Iudae : Housman and Büch. (1910) inde . Housman thinks a line has dropped out.","number":"","sourceTag":"note","start":246,"end":389}]},"2.6.597-606":{"sourceLength":473,"sourceTextSha256":"da1fe3844f1d758174bad3637bb63cbcf968da955d83178f8fd3c2a125c6e417","notes":[{"kind":"editorial","text":"omnes Ψ : omni PT and most edd.","number":"","sourceTag":"note","start":442,"end":473}]},"2.6.605-614":{"sourceLength":483,"sourceTextSha256":"7d045564f2312e1ab764ebd926490dc420e0d35860a0973c9332025c411a1d96","notes":[{"kind":"editorial","text":"omnes Ψ : omni PT and most edd.","number":"","sourceTag":"note","start":86,"end":117}]},"2.6.613-619":{"sourceLength":554,"sourceTextSha256":"63ee381dd6db40c9c6fd2bc98f2d228cae9c23580a87c284ef1d65bd1dec4ee1","notes":[{"kind":"editorial","text":"Clausen brakets 6.614abc, which is placed after 6.614 in U, after 6.601 in K, and in the marginalia of certain texts","number":"","sourceTag":"note","start":134,"end":250}]},"2.6.658-661":{"sourceLength":240,"sourceTextSha256":"133cf74922bc7a72a87c69cd805905e9b3364c719c270dc4e22af153ad592cd6","notes":[{"kind":"editorial","text":"praegustabit PSG: praegustaret Ψ : praegustarit Markl. and Housman.","number":"","sourceTag":"note","start":122,"end":189}]},"3.7.33-42":{"sourceLength":518,"sourceTextSha256":"b93c5e8daca524a592d8c8ab0e55aac6d88798554976f1e42a6de4809da39d05","notes":[{"kind":"editorial","text":"maculosas Heinr.: maculonsas Ribb. Housman: maculonus Ψ , maculonis PGBüch.","number":"","sourceTag":"note","start":344,"end":419}]},"3.7.49-58":{"sourceLength":635,"sourceTextSha256":"733e0404ae6d43c04fcce0fd4a81030f54cb31a632393ca4925151dd42ec4153","notes":[{"kind":"editorial","text":"The text of lines 50-52 is evidently corrupt Part of the passage seems to be a gloss, but, even if line 51 be eliminated, lines 50 and 52 can scarcely be translated though the general sense is clear.","number":"","sourceTag":"note","start":123,"end":322}]},"3.7.97-106":{"sourceLength":479,"sourceTextSha256":"f8a0f5a43f0ca06488b521402c7cb1eeb8ef33115fa50fee5e21f900a69e361a","notes":[{"kind":"editorial","text":"perit PFG: petit Ψ","number":"","sourceTag":"note","start":100,"end":118}]},"3.7.105-114":{"sourceLength":469,"sourceTextSha256":"95a2901c2778b709a1511b52671065525e66c79660b132354a16894745df7b1e","notes":[{"kind":"editorial","text":"Lacertae Ψ : Lacernae P.","number":"","sourceTag":"note","start":443,"end":467}]},"3.7.113-122":{"sourceLength":463,"sourceTextSha256":"91a7d83d77e612da4726a8b8bfd61dd989050c1e5fd530d51c694067cab2f53a","notes":[{"kind":"editorial","text":"Lacertae Ψ : Lacernae P.","number":"","sourceTag":"note","start":86,"end":110}]},"3.7.137-146":{"sourceLength":506,"sourceTextSha256":"11927267f8656b2a7731565a4edb21bb339800d2c4daee6e23991329e781859b","notes":[{"kind":"editorial","text":"Instead of fidimus eloquio Ψ has ut redeant veteres .","number":"","sourceTag":"note","start":104,"end":157}]},"3.7.153-162":{"sourceLength":508,"sourceTextSha256":"936799dab45acd4efd7afd0419c10f26397351698c63878bd504ee3db8dd8b41","notes":[{"kind":"editorial","text":"parte . So Ψ : P and Büch. have forte .","number":"","sourceTag":"note","start":180,"end":219}]},"3.7.161-170":{"sourceLength":468,"sourceTextSha256":"7e9ced573966c1ca94038c5399022659a9ab52d7c9b8a09c8bfb8